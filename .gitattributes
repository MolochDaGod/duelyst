# Duelyst / BadBudz / GrudaWars card art, sprites, atlases, icons
# Track via Git LFS so Cloudflare R2 receives the final optimized assets

*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text
*.atlas filter=lfs diff=lfs merge=lfs -text
*.plist filter=lfs diff=lfs merge=lfs -text
*.json filter=lfs diff=lfs merge=lfs -text

# Common card / sprite directories (add more as new sets land)
app/**/cards/** filter=lfs diff=lfs merge=lfs -text
app/**/sprites/** filter=lfs diff=lfs merge=lfs -text
app/**/icons/** filter=lfs diff=lfs merge=lfs -text
public/**/cards/** filter=lfs diff=lfs merge=lfs -text
public/**/sprites/** filter=lfs diff=lfs merge=lfs -text
public/**/og/** filter=lfs diff=lfs merge=lfs -text
assets/** filter=lfs diff=lfs merge=lfs -text
lab/tools/_cutouts/** filter=lfs diff=lfs merge=lfs -text
lab/tools/_dupe/** filter=lfs diff=lfs merge=lfs -text
